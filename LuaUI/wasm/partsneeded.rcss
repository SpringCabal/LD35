body { width: 100%; height: 100%; font-family: FreeSans; pointer-events: none; }
#space-prompt { position: absolute; left: 40%; top: 40%; color: white; font-size: 20dp; }
#ending { position: absolute; left: 25%; top: 47%; width: 50%; color: #cce6ff; font-size: 16dp; text-align: center; }
.hidden { display: none; }
